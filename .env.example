# Copy to .env to change defaults. Everything here is optional.

# Port for the local server (default 3000). The server only listens on 127.0.0.1.
JARCHI_PORT=3000

# Where settings.json and uploads/ are stored (default: ./data next to the app).
# JARCHI_DATA_DIR=

# Twitch key for the chat widget (optional). Without it chat works, with Twitch's common badges.
# With it: every Twitch badge, channels' own subscriber badges, and Twitch profile pictures.
# Create an app at https://dev.twitch.tv/console (no login for viewers needed). Never commit the real values.
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=
