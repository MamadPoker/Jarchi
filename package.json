{
  "name": "jarchi",
  "productName": "Jarchi",
  "version": "1.0.9",
  "private": true,
  "description": "Stream alerts (and later more widgets) for OBS. Runs locally on your own PC.",
  "author": "MamadPoker",
  "license": "MIT",
  "main": "electron/main.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server/index.js",
    "app": "electron .",
    "test": "node --test",
    "dist": "node build/notes.js && electron-builder --win --publish never"
  },
  "engines": {
    "node": ">=20.18.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MamadPoker/Jarchi.git"
  },
  "homepage": "https://github.com/MamadPoker/Jarchi",
  "dependencies": {
    "electron-updater": "^6.8.11",
    "express": "^5.3.0",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "undici": "^7.30.1"
  },
  "devDependencies": {
    "@semantic-release/git": "11.0.1",
    "@semantic-release/release-notes-generator": "14.1.1",
    "conventional-changelog-conventionalcommits": "10.4.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "semantic-release": "25.0.9"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "^11.0.1"
  },
  "build": {
    "appId": "com.mamadpoker.jarchi",
    "files": [
      "electron/**",
      "server/**",
      "core/**",
      "connectors/**",
      "panel/**",
      "widgets/**",
      "assets/**",
      "i18n/**",
      "!{data,relay,test,dist,build,.claude,.wrangler,.git}{,/**}",
      "!assets/Claude outputs{,/**}",
      "!**/.env",
      "!**/.env.*",
      "!**/wrangler.toml",
      "!**/*.test.{js,mjs,cjs}",
      "!**/*.{pem,key,pfx,p12}"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/brand/icons/jarchi.ico"
    },
    "nsis": {
      "oneClick": false,
      "artifactName": "Jarchi-Setup.${ext}",
      "installerLanguages": [
        "en_US",
        "fa_IR"
      ],
      "displayLanguageSelector": true
    },
    "publish": {
      "provider": "github",
      "owner": "MamadPoker",
      "repo": "Jarchi",
      "releaseType": "draft"
    },
    "releaseInfo": {
      "releaseNotesFile": "build/release-notes.md"
    }
  }
}
